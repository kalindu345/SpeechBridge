<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@color/md_theme_primary"
    android:padding="20dp">

    <!-- App Title -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speech Bridge"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Welcome Text -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/appTitle"
        android:layout_marginTop="4dp"
        android:text="Welcome!"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <!-- Profile Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/header_profile_pic"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/welcomeText"
        android:layout_marginTop="15dp"
        android:src="@drawable/profile"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImage"/>

    <!-- Username -->
    <TextView
        android:id="@+id/headerUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/header_profile_pic"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@id/header_profile_pic"
        android:text="Guest Therapist"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Email -->
    <TextView
        android:id="@+id/headerUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You are not logged in"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:layout_toEndOf="@id/header_profile_pic"
        android:layout_marginStart="15dp"
        android:layout_below="@id/headerUserName"/>

</RelativeLayout>
