<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="50dp"
    tools:context=".activity.TherapistSignInActivity">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/app_logo"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Therapist SignIn"
        android:textColor="@color/md_theme_primary"
        android:textSize="17sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="12sp"
        android:textColor="@color/md_theme_primary"
        android:text="@string/email_text"/>

    <EditText
        android:id="@+id/signin_therapist_input_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:inputType="textEmailAddress"
        android:textSize="12sp"
        android:hint="@string/user_example_com"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/custom_input_search"/>

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="12sp"
        android:textColor="@color/md_theme_primary"
        android:text="@string/password"/>

    <EditText
        android:id="@+id/signin_therapist_input_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        android:inputType="textPassword"
        android:textSize="12sp"
        android:hint="@string/passwordHint"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/custom_input_search"/>

    <TextView
        android:id="@+id/signin_forget_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:layout_gravity="end"
        android:textColor="@color/md_theme_secondary"
        android:text="@string/forgot_password"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/therapist_signIn_signInBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sign_in"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:text="Or create new account"
        android:textSize="12sp"
        android:textColor="@color/md_theme_primary"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/therapist_signIn_signUpBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Sign Up"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginTop="4dp"/>


</LinearLayout>