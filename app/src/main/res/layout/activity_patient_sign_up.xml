<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    tools:context=".activity.PatientSignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/app_logo"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Sign Up"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"/>

        <!-- Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:layout_marginBottom="10dp"
            android:textSize="12sp"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="14dp"/>

        <EditText
            android:id="@+id/signup_input_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="John Doe"
            android:background="@drawable/custom_input_search"
            android:padding="10dp"
            android:textSize="12sp"/>

        <!-- Mobile -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/signup_input_mobile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="07X XXX XXXX"
            android:inputType="phone"
            android:background="@drawable/custom_input_search"
            android:padding="10dp"
            android:textSize="12sp"/>

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/signup_input_email"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="user@example.com"
            android:inputType="textEmailAddress"
            android:background="@drawable/custom_input_search"
            android:padding="10dp"
            android:textSize="12sp"/>

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/signup_input_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:background="@drawable/custom_input_search"
            android:padding="10dp"
            android:textSize="12sp"/>

        <!-- Confirm Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textSize="12sp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/signup_input_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:background="@drawable/custom_input_search"
            android:padding="10dp"
            android:textSize="12sp"/>

        <!-- Sign Up -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signup_signUpBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sign Up"
            android:layout_marginTop="14dp"/>

        <!-- Already account -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account?"
            android:textSize="12sp"
            android:textAlignment="center"
            android:layout_marginTop="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signUp_signInBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Sign In"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>