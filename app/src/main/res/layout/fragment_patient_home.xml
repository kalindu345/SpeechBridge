<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/cardview_light_background">

    <!-- Header -->
    <TextView
        android:id="@+id/homeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Welcome to Speech Bridge!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Image Slider -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeImageSlider"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/homeHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/md_theme_primary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/homeImageSlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tips Title -->
    <TextView
        android:id="@+id/homeTipsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tips from Therapists"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/homeImageSlider"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Tips Cards Container -->
    <LinearLayout
        android:id="@+id/homeTipsContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/homeTipsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Example Tip Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Practice daily pronunciation exercises."
                android:textSize="18sp"
                android:textColor="@color/md_theme_primary"

                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Speak slowly and clearly."
                android:textSize="18sp"
                android:textColor="@color/md_theme_primary"

                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Take deep breaths before speaking."
                android:textSize="18sp"
                android:textColor="@color/md_theme_primary"

                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Break words into smaller sounds."
                android:textSize="18sp"
                android:textColor="@color/md_theme_primary"

                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>