<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".fragment.PatientSessionViewFragment">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Sessions"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <!-- Search Input -->
    <EditText
        android:id="@+id/searchSession"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="Search therapist..."
        android:padding="10dp"
        android:background="@drawable/custom_input_search"
        android:layout_marginBottom="10dp"
        android:inputType="text"
        android:imeOptions="actionDone"/>

    <!-- Empty View -->
    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No sessions booked yet"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="20dp"/>

    <!-- RecyclerView for sessions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sessionRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_patient_session_card"/>

</LinearLayout>