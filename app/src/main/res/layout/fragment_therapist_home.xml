<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/cardview_light_background">

    <!-- Header -->
    <TextView
        android:id="@+id/therapistHomeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Welcome Therapist!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Image Slider -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/therapistImageSlider"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/therapistHomeHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/md_theme_primary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/therapistImageSlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Section Title -->
    <TextView
        android:id="@+id/therapistTipsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Therapist Guidelines"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/therapistImageSlider"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Cards Container -->
    <LinearLayout
        android:id="@+id/therapistTipsContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/therapistTipsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Card 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Review patient progress regularly."
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Encourage consistent practice at home."
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Use interactive tools for better engagement."
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Track and update therapy goals frequently."
                android:textSize="16sp"
                android:textColor="@color/md_theme_primary"
                android:gravity="center_vertical|start"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </com.google.android.material.card.MaterialCardView>




    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>